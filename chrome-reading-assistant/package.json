{
  "name": "reading-progress-saver",
  "version": "1.0.0",
  "description": "A Chrome extension that selectively saves and restores reading progress across websites",
  "main": "background.js",
  "scripts": {
    "build": "npm run build:icons && npm run build:extension",
    "build:icons": "node scripts/generate-icons.js",
    "build:extension": "node scripts/build-extension.js",
    "dev": "npm run build && echo 'Extension built! Load the dist/ folder in Chrome'",
    "test": "echo 'No tests specified'",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "package": "npm run build && node scripts/package-extension.js"
  },
  "keywords": [
    "chrome-extension",
    "reading-progress",
    "bookmark",
    "scroll-position",
    "productivity",
    "reading"
  ],
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com",
    "url": "https://github.com/yourusername"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/reading-progress-saver.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/reading-progress-saver/issues"
  },
  "homepage": "https://github.com/yourusername/reading-progress-saver#readme",
  "devDependencies": {
    "eslint": "^8.0.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.25.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "chrome": {
    "minimum_version": "88"
  }
}
